# Copy to .env and fill in. Never commit .env.
# Zhihu: log in at https://www.zhihu.com in your browser, then DevTools → Application → Cookies → https://www.zhihu.com
ZHIHU_Z_C0=
ZHIHU_XSRF=
ZHIHU_D_C0=
# Feishu: lark-cli profile that can read the source docs (empty = default profile)
LARK_PROFILE=
# WeChat Official Account: 微信开发者平台 → 我的业务 → 公众号 → 基础信息 (AppID / AppSecret); add your public IP to the API IP whitelist
WECHAT_APPID=
WECHAT_APPSECRET=
